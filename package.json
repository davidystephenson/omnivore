{
  "name": "omnivore",
  "version": "0.0.0",
  "description": "",
  "scripts": {
    "build:server": "npx tsc",
    "build:client": "npx parcel build src/client/index.html",
    "build": "npm run build:server && npm run build:client",
    "off": "npm run build && node --enable-source-maps --max-old-space-size=4096 build/server/offBook.js",
    "on": "npm run build && node --enable-source-maps --max-old-space-size=4096 build/server/onBook.js",
    "rehearse": "npm run build && npm run serve",
    "resume": "npm run off public download",
    "serve": "node --enable-source-maps build/server/rehearse.js",
    "start": "npm run build && node --enable-source-maps --max-old-space-size=4096 build/server/produce.js",
    "watch:server": "npx onchange -i -k \"src/shared/**\" \"src/server/**\" -- npm run serve",
    "watch:client": "npx onchange -i -k \"src/shared/**\" \"src/client/**\" -- npm run build:client",
    "watch": "npx concurrently \"npm run watch:server\" \"npm run watch:client\""
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/davidystephenson/omnivore.git"
  },
  "author": "David Y. Stephenson and Daniel G. Stephenson",
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/davidystephenson/omnivore/issues"
  },
  "homepage": "https://github.com/davidystephenson/omnivore#readme",
  "dependencies": {
    "@duplojs/zod-accelerator": "^2.6.2",
    "big-json": "^3.2.0",
    "decompress": "^4.2.1",
    "express": "^4.18.2",
    "fs": "^0.0.1-security",
    "fs-extra": "^11.3.0",
    "planck": "^1.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/big-json": "^3.2.5",
    "@types/decompress": "^4.2.7",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "buffer": "^6.0.3",
    "parcel": "^2.11.0",
    "process": "^0.11.10",
    "ts-standard": "^12.0.2",
    "typescript": "^5.3.3"
  }
}
